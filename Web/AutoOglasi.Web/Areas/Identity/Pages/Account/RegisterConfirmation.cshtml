@page
@model AutoOglasi.Web.Areas.Identity.Pages.Account.RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirm your email";
}

<div class="d-flex justify-content-center align-items-center py-5">
    <div class="card luxury-card shadow-lg luxury-auth-card">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <span class="text-uppercase small font-monospace luxury-gold-sub-text luxury-sub-spacing-sm">Account</span>
                <h2 class="fw-light text-uppercase mt-1 text-theme-heading luxury-title-spacing">Check Your Email</h2>
                <div class="mx-auto mt-2 luxury-deco-line-sm"></div>
            </div>

            <p class="text-center small font-monospace mb-4 autooglasi-recovery-subtitle">
                We sent a confirmation link to <strong>@Model.Email</strong>. Please open that email and confirm your account before signing in.
            </p>

            <partial name="_StatusMessage" model="@((string)ViewData["StatusMessage"] ?? (string)TempData["StatusMessage"])" />

            <div class="d-grid gap-2">
                <a asp-page="./Login" class="btn text-uppercase py-3 fw-bold border luxury-btn-gold-outline luxury-btn-size-md luxury-tracking-wide">
                    Go to Sign In
                </a>
                <a asp-page="./ResendEmailConfirmation" class="btn btn-outline-secondary text-uppercase py-3 fw-bold rounded-0 luxury-btn-size-md luxury-tracking-wide">
                    Resend Confirmation Email
                </a>
            </div>
        </div>
    </div>
</div>
