    "PermitLimit": 120,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "EmailSettings": {
    "Username": "",
    "SmtpPort": 0,
    "SmtpHost": "",
    "Secure": "",
    "Password": "",
    "EnableSsl": false,
    "From": ""
  }
}
